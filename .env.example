# Required secrets. Generate independent values; see README.md.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-64-hex-characters

# App server and storage
NODE_ENV=production
PORT=3000
DATABASE_PATH=./data/bale-manager.sqlite
# Public HTTPS origin; needed to register per-bot webhooks automatically.
APP_BASE_URL=https://bots.example.com
# Set to 1 only when the app is behind a trusted reverse proxy.
TRUST_PROXY=0
